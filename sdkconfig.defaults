# ESP32-C3 EPD Display sdkconfig defaults

# Target & Flash
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"


# Console Output: USB-Serial/JTAG for ESP32-C3 SuperMini
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS & System (Reduced main task stack to reclaim SRAM)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# Compiler Optimization for Size (Saves Flash & I-Cache)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Enable Lightweight Bluetooth LE 5.0 (NimBLE Peripheral Only)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="EPD-Smart-Display"
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# Disable C-SDK mDNS (We use lightweight Rust mDNS in 4KB stack)
CONFIG_MDNS_ENABLED=n

# WiFi & Networking RAM Optimization
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# NimBLE Buffer Optimization (Conserves SRAM on ESP32-C3)
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=8

# HTTP Server Configuration (Optimized for RAM & Route Capacity)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_MAX_URI_HANDLERS=36
CONFIG_HTTPD_MAX_OPEN_SOCKETS=7
CONFIG_HTTPD_WS_SUPPORT=n

# mbedTLS Heap Optimization (Conserves SRAM on ESP32-C3)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
